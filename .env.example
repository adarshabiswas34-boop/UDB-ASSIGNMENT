# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Global Rate Limiter Configuration
RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_KEY_PREFIX=ratelimit

# Route-Specific Rate Limits
RATE_LIMIT_DATA_LIMIT=60
RATE_LIMIT_DATA_WINDOW=60
RATE_LIMIT_EXPENSIVE_LIMIT=5
RATE_LIMIT_EXPENSIVE_WINDOW=60

# Redis Configuration (Primary in-memory store for rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=20

# MongoDB Configuration (Alternative document store for rate limiting)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=rate_limiter_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# SQL Database Configuration (Optional / Relational metadata)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rate_limiter_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rate_limiter_db
